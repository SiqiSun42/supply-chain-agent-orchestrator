# ---------------------------------------------------------------------------
# Agent Orchestrator configuration. Copy to `.env` and adjust.
# Every variable is optional: the defaults run fully offline with no infra.
# ---------------------------------------------------------------------------

# --- Models ------------------------------------------------------------------
# mock (offline, deterministic) | anthropic | openai (OpenAI-compatible, e.g. DeepSeek)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# DeepSeek (OpenAI-compatible): structured supervisor/finalizer use chat.completions.create
# with response_format={"type": "json_object"} when OPENAI_BASE_URL is set (auto).
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat
# OPENAI_STRUCTURED_MODE=auto
# Optional cheaper/faster model for the supervisor router
# SUPERVISOR_MODEL=
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120

# hashing (offline) | openai
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=text-embedding-3-small

# --- Persistence -------------------------------------------------------------
# Local default is SQLite; docker-compose overrides with Postgres.
DATABASE_URL=sqlite:///./data/orchestrator.db
# auto -> postgres when DATABASE_URL is Postgres, otherwise sqlite | memory
CHECKPOINTER=auto
CHECKPOINT_SQLITE_PATH=./data/checkpoints.db

# --- Queue / events ----------------------------------------------------------
# inline = in-process thread pool (no broker); celery = Redis + Celery workers
RUN_EXECUTOR=inline
# REDIS_URL=redis://localhost:6379/0
# auto -> redis when REDIS_URL is set, otherwise in-memory
EVENT_BUS=auto

# --- Vector memory -----------------------------------------------------------
# chroma | memory
VECTOR_STORE=chroma
# ephemeral | persistent | http
CHROMA_MODE=persistent
CHROMA_PATH=./data/chroma
# CHROMA_HOST=localhost
# CHROMA_PORT=8000
CHROMA_COLLECTION=agent_memories

# --- Orchestration policy ----------------------------------------------------
MAX_SUPERVISOR_STEPS=6
MAX_AGENT_VISITS=2
MAX_TOOL_ROUNDS=4
REFUND_APPROVAL_THRESHOLD=100
EMAIL_REQUIRES_APPROVAL=true
CONFIDENCE_THRESHOLD=0.55
MEMORY_RECALL_K=5
MEMORY_MIN_SCORE=0.12
# false = skip recall, extraction and persistence (graph and tools stay wired)
LONG_TERM_MEMORY_ENABLED=false
SUPPLY_CHAIN_DB_PATH=./data/supply_chain.db

# --- API ---------------------------------------------------------------------
LOG_LEVEL=INFO
# console | json
LOG_FORMAT=console
CORS_ORIGINS=http://localhost:5173
# Host ports used by docker compose
API_PORT=8000
UI_PORT=8080
